<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#FBF8F3</item>
    </style>

    <!-- 全屏响铃页：无标题栏、深色底、贴锁屏显示 -->
    <style name="RingTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#14110E</item>
        <item name="android:statusBarColor">#14110E</item>
        <item name="android:navigationBarColor">#14110E</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
